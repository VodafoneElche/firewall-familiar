<Window x:Class="FirewallFamiliar.Views.CleanupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Limpieza y revisión del PC - Firewall Familiar" Width="1100" Height="640" MinWidth="760" MinHeight="420"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="8">
        <TextBlock DockPanel.Dock="Bottom" x:Name="StatusText" Margin="0,6,0,0" Foreground="#555" TextWrapping="Wrap"/>
        <TabControl x:Name="Tabs">

            <!-- ===== Programas que arrancan solos ===== -->
            <TabItem Header="Programas que arrancan solos">
                <DockPanel Margin="6">
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="#333">
                        Todo lo que se pone en marcha sin que nadie lo abra: inicio de Windows, tareas programadas, servicios,
                        extensiones del menú contextual y ajustes del navegador. Pincha una línea y abajo verás qué es y qué conviene hacer.
                        Naranja = conviene mirarlo. Gris = resto de un programa que ya no está. "Desactivar" se puede deshacer;
                        "Eliminar entrada" la quita para siempre (antes guarda una copia).
                    </TextBlock>
                    <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <Button x:Name="BtnDisable" Content="Desactivar" Padding="12,3" Margin="0,0,8,0" Click="OnDisable"/>
                        <Button x:Name="BtnEnable" Content="Volver a activar" Padding="12,3" Margin="0,0,8,0" Click="OnEnable"/>
                        <Button x:Name="BtnRemove" Content="Eliminar entrada" Padding="12,3" Margin="0,0,8,0" Click="OnRemove"
                                ToolTip="Quita la entrada para siempre. Antes guarda una copia en C:\ProgramData\FirewallFamiliar\copias-limpieza"/>
                        <Button Content="Abrir ubicación del archivo" Padding="12,3" Margin="0,0,8,0" Click="OnOpenStartupFile"/>
                        <Button Content="Actualizar" Padding="12,3" Margin="0,0,16,0" Click="OnRefreshStartup"/>
                        <CheckBox x:Name="ChkMicrosoft" Content="Mostrar también lo de Microsoft (Windows)" VerticalAlignment="Center" Click="OnFilterStartup"/>
                    </WrapPanel>
                    <Border DockPanel.Dock="Bottom" Background="#F4F7FC" BorderBrush="#C8D4E8" BorderThickness="1" Padding="8" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock x:Name="DetailAdvice" TextWrapping="Wrap" FontWeight="SemiBold" Text="Pincha una línea para ver qué es y qué conviene hacer."/>
                            <TextBlock x:Name="DetailInfo" TextWrapping="Wrap" Foreground="#444" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <ListView x:Name="StartupList" SelectionMode="Single" SelectionChanged="OnStartupSelected">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="ToolTip" Value="{Binding Command}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Level}" Value="3">
                                        <Setter Property="Background" Value="#FFDCB4"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Level}" Value="2">
                                        <Setter Property="Background" Value="#F0F0F0"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Enabled}" Value="False">
                                        <Setter Property="Foreground" Value="#888"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Nivel" Width="80" DisplayMemberBinding="{Binding LevelText}"/>
                                <GridViewColumn Header="Tipo" Width="120" DisplayMemberBinding="{Binding Kind}"/>
                                <GridViewColumn Header="Nombre" Width="200" DisplayMemberBinding="{Binding Name}"/>
                                <GridViewColumn Header="Usuario" Width="80" DisplayMemberBinding="{Binding User}"/>
                                <GridViewColumn Header="Activo" Width="80" DisplayMemberBinding="{Binding EnabledText}"/>
                                <GridViewColumn Header="Firma" Width="170" DisplayMemberBinding="{Binding SignatureText}"/>
                                <GridViewColumn Header="Archivo" Width="260" DisplayMemberBinding="{Binding Shown}"/>
                                <GridViewColumn Header="Motivo" Width="300" DisplayMemberBinding="{Binding RiskText}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </TabItem>

            <!-- ===== Restos de programas ===== -->
            <TabItem Header="Restos de programas">
                <DockPanel Margin="6">
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="#333">
                        Carpetas que no son de ningún programa instalado y llevan meses sin cambiar, y carpetas de programas basura conocidos
                        (SweetLabs, OneLaunch...). Marca las que quieras quitar: van a la Papelera, así que se pueden recuperar.
                        Si no sabes qué es una carpeta, déjala.
                    </TextBlock>
                    <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <Button x:Name="BtnRecycle" Content="Mandar las marcadas a la Papelera" Padding="12,3" Margin="0,0,8,0" Click="OnRecycle"/>
                        <CheckBox x:Name="ChkAll" Content="Marcar todos" VerticalAlignment="Center" Margin="0,0,14,0" Click="OnSelectAll"/>
                        <Button Content="Abrir carpeta" Padding="12,3" Margin="0,0,8,0" Click="OnOpenLeftover"/>
                        <Button Content="Buscar otra vez" Padding="12,3" Click="OnRefreshLeftovers"/>
                    </WrapPanel>
                    <ListView x:Name="LeftoverList" SelectionMode="Single">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="ToolTip" Value="{Binding Reason}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding KnownJunk}" Value="True">
                                        <Setter Property="Background" Value="#FFDCB4"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Quitar" Width="55">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" IsEnabled="{Binding CanSelect}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Estado" Width="130" DisplayMemberBinding="{Binding StateText}"/>
                                <GridViewColumn Header="Carpeta" Width="170" DisplayMemberBinding="{Binding Name}"/>
                                <GridViewColumn Header="Dónde" Width="190" DisplayMemberBinding="{Binding Where}"/>
                                <GridViewColumn Header="Tamaño" Width="80" DisplayMemberBinding="{Binding SizeText}"/>
                                <GridViewColumn Header="Último cambio" Width="95" DisplayMemberBinding="{Binding LastChangeText}"/>
                                <GridViewColumn Header="Ruta completa" Width="330" DisplayMemberBinding="{Binding Path}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </TabItem>

            <!-- ===== Discos y chequeo ===== -->
            <TabItem Header="Discos y chequeo de seguridad">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="6">
                        <TextBlock Text="Salud de los discos" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
                        <ListView x:Name="DiskList" Margin="0,0,0,6">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Disco" Width="230" DisplayMemberBinding="{Binding Model}"/>
                                    <GridViewColumn Header="Tipo" Width="110" DisplayMemberBinding="{Binding Type}"/>
                                    <GridViewColumn Header="Tamaño" Width="70" DisplayMemberBinding="{Binding SizeText}"/>
                                    <GridViewColumn Header="Temperatura" Width="85" DisplayMemberBinding="{Binding TemperatureText}"/>
                                    <GridViewColumn Header="Desgaste" Width="70" DisplayMemberBinding="{Binding WearText}"/>
                                    <GridViewColumn Header="Horas encendido" Width="105" DisplayMemberBinding="{Binding HoursText}"/>
                                    <GridViewColumn Header="Estado" Width="380" DisplayMemberBinding="{Binding Summary}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <ItemsControl x:Name="VolumeList" Margin="0,0,0,14">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding Text}" Margin="0,1"/></DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Chequeo de seguridad de Windows" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
                        <ListView x:Name="CheckList">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="" Width="85" DisplayMemberBinding="{Binding StateText}"/>
                                    <GridViewColumn Header="Comprobación" Width="230" DisplayMemberBinding="{Binding Name}"/>
                                    <GridViewColumn Header="Resultado" Width="700">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate><TextBlock Text="{Binding Text}" TextWrapping="Wrap" MaxWidth="680"/></DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <TextBlock TextWrapping="Wrap" Foreground="#555" Margin="0,10,0,0">
                            El servicio de Firewall Familiar repite estas comprobaciones solo y avisa al SOC familiar si un disco puede fallar,
                            si algo del chequeo pasa de bien a mal o si se añade al arranque un programa sin firma.
                        </TextBlock>
                        <Button Content="Comprobar otra vez" Padding="12,3" HorizontalAlignment="Left" Margin="0,10,0,0" Click="OnRefreshHealth"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
