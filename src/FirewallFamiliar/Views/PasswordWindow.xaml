<Window x:Class="FirewallFamiliar.Views.PasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Contraseña - Firewall Familiar" Width="380" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Topmost="True" ShowInTaskbar="False">
    <StackPanel Margin="16">
        <DockPanel>
            <Image Source="/Assets/logo.png" Width="40" Height="40" DockPanel.Dock="Left" Margin="0,0,12,0" VerticalAlignment="Top"/>
            <TextBlock x:Name="Message" TextWrapping="Wrap" FontSize="13"/>
        </DockPanel>
        <TextBlock x:Name="Label1" Text="Contraseña:" Margin="0,14,0,3"/>
        <PasswordBox x:Name="Pwd1" Height="26" VerticalContentAlignment="Center"/>
        <StackPanel x:Name="ConfirmPanel" Visibility="Collapsed">
            <TextBlock Text="Repite la contraseña:" Margin="0,10,0,3"/>
            <PasswordBox x:Name="Pwd2" Height="26" VerticalContentAlignment="Center"/>
        </StackPanel>
        <TextBlock x:Name="Error" Foreground="Red" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Aceptar" Width="90" Height="28" IsDefault="True" Click="OnOk" Margin="0,0,8,0"/>
            <Button Content="Cancelar" Width="90" Height="28" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
