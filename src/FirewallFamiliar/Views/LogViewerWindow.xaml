<Window x:Class="FirewallFamiliar.Views.LogViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registros - Firewall Familiar" Width="1100" Height="640" MinWidth="700" MinHeight="400"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="8">
        <!-- Controles -->
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="Registro:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="CmbKind" Width="230" SelectionChanged="OnKindChanged" Margin="0,0,16,0">
                <ComboBoxItem Content="Seguridad (avisos, bloqueos, reglas)" IsSelected="True"/>
                <ComboBoxItem Content="Tráfico (todas las conexiones)"/>
            </ComboBox>
            <TextBlock Text="Día:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="CmbDay" Width="190" SelectionChanged="OnDayChanged" Margin="0,0,16,0"/>
            <TextBlock Text="Mostrar:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="CmbShow" Width="200" SelectionChanged="OnFilterChanged" Margin="0,0,16,0">
                <ComboBoxItem Content="Todo" IsSelected="True"/>
                <ComboBoxItem Content="Solo bloqueos"/>
                <ComboBoxItem Content="Solo permitidos"/>
                <ComboBoxItem Content="Solo avisos (ataques, sospechosos)"/>
                <ComboBoxItem Content="Solo entrantes"/>
            </ComboBox>
            <TextBlock Text="Buscar:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="SearchBox" Width="170" TextChanged="OnFilterChanged" VerticalContentAlignment="Center" Margin="0,0,16,0"/>
            <Button Content="Actualizar" Padding="10,2" Margin="0,0,6,0" Click="OnRefresh"/>
            <Button Content="Exportar..." Padding="10,2" Margin="0,0,6,0" Click="OnExport" ToolTip="Guardar lo que se ve en un archivo para abrir con Excel"/>
            <Button Content="Abrir carpeta" Padding="10,2" Margin="0,0,6,0" Click="OnOpenFolder"/>
            <Button x:Name="BtnAnalysis" Content="🔍 Preparar para análisis..." Padding="10,2" FontWeight="SemiBold" Click="OnAnalysis"
                    ToolTip="Crea un informe en el Escritorio para enviárselo a Claude y que lo revise a fondo">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Solo hoy" Tag="1" Click="OnAnalysisDays"/>
                        <MenuItem Header="Últimos 7 días" Tag="7" Click="OnAnalysisDays"/>
                        <MenuItem Header="Últimos 30 días" Tag="30" Click="OnAnalysisDays"/>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
        </WrapPanel>

        <TextBlock DockPanel.Dock="Bottom" x:Name="StatusText" Margin="0,6,0,0" Foreground="#555"/>

        <ListView x:Name="List" MouseDoubleClick="OnDoubleClick" GridViewColumnHeader.Click="OnHeaderClick"
                  ToolTip="Doble clic en una línea para ver la ficha del programa y de la dirección IP">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Outcome}" Value="Bloqueado">
                            <Setter Property="Foreground" Value="#B00000"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Outcome}" Value="Escaneo">
                            <Setter Property="Background" Value="#FFC8C8"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Outcome}" Value="Sospechoso">
                            <Setter Property="Background" Value="#FFDCB4"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Outcome}" Value="Oculto">
                            <Setter Property="Background" Value="#FFEBD2"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Hora" Width="70" DisplayMemberBinding="{Binding TimeText}"/>
                    <GridViewColumn Header="Resultado" Width="85" DisplayMemberBinding="{Binding Outcome}"/>
                    <GridViewColumn Header="Programa" Width="150" DisplayMemberBinding="{Binding AppName}"/>
                    <GridViewColumn Header="Sentido" Width="80" DisplayMemberBinding="{Binding DirectionText}"/>
                    <GridViewColumn Header="Equipo remoto" Width="190" DisplayMemberBinding="{Binding RemoteText}"/>
                    <GridViewColumn Header="Para qué" Width="160" DisplayMemberBinding="{Binding PortMeaning}"/>
                    <GridViewColumn Header="Protocolo" Width="65" DisplayMemberBinding="{Binding Protocol}"/>
                    <GridViewColumn Header="Mensaje" Width="600" DisplayMemberBinding="{Binding Text}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
