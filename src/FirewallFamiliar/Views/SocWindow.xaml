<Window x:Class="FirewallFamiliar.Views.SocWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SOC familiar - Firewall Familiar" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="16">
        <DockPanel>
            <Image Source="/Assets/logo.png" Width="40" Height="40" DockPanel.Dock="Left" Margin="0,0,12,0" VerticalAlignment="Top"/>
            <TextBlock TextWrapping="Wrap" FontSize="13">
                Este PC mandará al Google Drive del SOC familiar un informe cada día, un aviso al momento si pasa algo
                grave (ataques, programas sospechosos, control remoto) y una señal cada 15 minutos para saber que sigue protegido.
            </TextBlock>
        </DockPanel>
        <TextBlock Text="Dirección del buzón (la de la aplicación web, termina en /exec):" Margin="0,14,0,3"/>
        <TextBox x:Name="UrlBox" Height="26" VerticalContentAlignment="Center"/>
        <TextBlock Text="Clave del buzón (la misma que pusiste en SECRETO):" Margin="0,10,0,3"/>
        <TextBox x:Name="KeyBox" Height="26" VerticalContentAlignment="Center"/>
        <TextBlock Text="Nombre de este PC en los informes (por ejemplo: Portátil de Lucía):" Margin="0,10,0,3"/>
        <TextBox x:Name="NameBox" Height="26" VerticalContentAlignment="Center"/>
        <TextBlock x:Name="Status" Margin="0,10,0,0" TextWrapping="Wrap"/>
        <DockPanel Margin="0,16,0,0" LastChildFill="False">
            <Button x:Name="BtnTest" Content="Probar" Width="90" Height="28" Click="OnTest" DockPanel.Dock="Left" Margin="0,0,8,0"/>
            <Button x:Name="BtnReport" Content="Enviar informe de hoy" Width="150" Height="28" Click="OnSendReport" DockPanel.Dock="Left"/>
            <Button Content="Cancelar" Width="90" Height="28" IsCancel="True" DockPanel.Dock="Right"/>
            <Button Content="Guardar" Width="90" Height="28" IsDefault="True" Click="OnSave" DockPanel.Dock="Right" Margin="0,0,8,0"/>
        </DockPanel>
    </StackPanel>
</Window>
