<Window x:Class="FirewallFamiliar.Views.RulesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FirewallFamiliar.Views"
        Title="Reglas - Firewall Familiar" Width="900" Height="560" MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="10">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" LastChildFill="False">
            <CheckBox x:Name="ChkWindows" DockPanel.Dock="Left" VerticalAlignment="Center"
                      Content="Permitir sin preguntar los programas de Windows (carpeta C:\Windows)"/>
            <Button DockPanel.Dock="Right" Content="Cancelar" Width="90" Height="28" IsCancel="True"/>
            <Button DockPanel.Dock="Right" Content="Aceptar" Width="90" Height="28" Margin="0,0,8,0" IsDefault="True" Click="OnOk"/>
        </DockPanel>

        <TabControl>
            <TabItem Header="Programas">
                <DockPanel Margin="6">
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Añadir programa..." Padding="10,3" Click="OnAddApp"/>
                        <Button Content="Quitar regla" Padding="10,3" Margin="8,0,0,0" Click="OnRemoveApp"/>
                        <TextBlock Text="Los programas sin regla siguen el modo general (preguntar o permitir)." Foreground="#666"
                                   VerticalAlignment="Center" Margin="14,0,0,0"/>
                    </StackPanel>
                    <ListView x:Name="AppsList">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Programa" Width="200">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding Name}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Acción" Width="120">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox SelectedValue="{Binding Action, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      SelectedValuePath="Tag" Width="100">
                                                <ComboBoxItem Content="Permitir" Tag="{x:Static local:RulesWindow.Permitir}"/>
                                                <ComboBoxItem Content="Bloquear" Tag="{x:Static local:RulesWindow.Bloquear}"/>
                                            </ComboBox>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Ruta" Width="460" DisplayMemberBinding="{Binding Path}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </TabItem>

            <TabItem Header="Reglas avanzadas (puertos e IP)">
                <DockPanel Margin="6">
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="#555" Margin="0,0,0,6"
                               Text="Se aplican de arriba abajo: si dos reglas coinciden, manda la que está más arriba. Tienen prioridad sobre las reglas de programas."/>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Nueva..." Padding="10,3" Click="OnNewAdvanced"/>
                        <Button Content="Editar..." Padding="10,3" Margin="8,0,0,0" Click="OnEditAdvanced"/>
                        <Button Content="Borrar" Padding="10,3" Margin="8,0,0,0" Click="OnDeleteAdvanced"/>
                        <Button Content="▲ Subir" Padding="10,3" Margin="20,0,0,0" Click="OnUp"/>
                        <Button Content="▼ Bajar" Padding="10,3" Margin="8,0,0,0" Click="OnDown"/>
                    </StackPanel>
                    <ListView x:Name="AdvancedList" MouseDoubleClick="OnEditAdvanced">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Activa" Width="55">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Nombre" Width="200" DisplayMemberBinding="{Binding Name}"/>
                                <GridViewColumn Header="Acción" Width="80" DisplayMemberBinding="{Binding Action}"/>
                                <GridViewColumn Header="Condiciones" Width="500" DisplayMemberBinding="{Binding Summary}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
