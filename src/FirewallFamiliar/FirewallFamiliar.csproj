<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>FirewallFamiliar</AssemblyName>
    <RootNamespace>FirewallFamiliar</RootNamespace>
    <Product>Firewall Familiar</Product>
    <Version>0.1.1</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lectura en tiempo real del tráfico de red por proceso (ETW del kernel) -->
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.1.20" />
    <!-- Consulta de servicios de Windows (WMI) -->
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

</Project>
